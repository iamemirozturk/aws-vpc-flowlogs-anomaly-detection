# ---------------------------------------------------------------------------
# terraform.tfvars.example — Multi-Account Deployment
# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars with real account IDs to version control.
# ---------------------------------------------------------------------------

central_account_id = "111122223333"
central_region     = "us-east-1"
log_bucket_name    = "acme-central-vpc-flowlogs"

spoke_accounts = [
  {
    account_id = "444455556666"
    vpc_ids    = ["vpc-aaaa1111bbbb2222", "vpc-cccc3333dddd4444"]
  },
  {
    account_id = "777788889999"
    vpc_ids    = ["vpc-eeee5555ffff6666"]
  },
]

# Detection — 50 GB threshold
exfil_threshold_bytes = 53687091200
alert_email           = "security-team@example.com"
detection_schedule    = "rate(1 hour)"

# Storage
log_retention_days         = 90
enable_object_lock         = true
object_lock_retention_days = 365

# Tagging
environment  = "prod"
project_name = "vpc-flowlogs-anomaly-detection"

tags = {
  CostCenter  = "security"
  Owner       = "cloud-security-team"
  Compliance  = "CIS-AWS-1.5"
}
